{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/ox-alpha-free",
  "formatter": true,
  "lsp": true,
  "share": "disabled",
  "autoupdate": "notify",
  "default_agent": "plan",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "coverage/**", ".next/**"],
  },
  "permission": {
    "external_directory": {
      "~/go/pkg/mod/*": "allow",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "bash": {
      "*": "ask",
      "go *": "allow",
      "gofmt *": "allow",
      "golangci-lint *": "allow",
      "pnpm exec prettier *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "find *-delete*": "deny",
      "find *-exec*": "deny",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cat *": "allow",
      "cat *.env": "deny",
      "cat *.env.*": "deny",
      "cat *.env.example": "allow",
      "cat ~/.ssh/*": "deny",
      "cat *.pem": "deny",
      "echo *": "allow",
      "echo *$*": "deny",
      "git show *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git stash *": "allow",
      "git stash clear*": "ask",
      "git stash drop *": "ask",
      "git status *": "allow",
      "sed *-i*": "ask",
      "sed *--in-place*": "ask",
      "awk *-i*": "ask",
      "awk *@load*": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git commit *": "ask",
      "git restore *": "ask",
      "git checkout *": "ask",
      "rm *": "ask",
    },
  },
  "agent": {
    "plan": {
      "model": "opencode-go/ox-alpha-free",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny",
      },
    },
    "build": {
      "mode": "primary",
      "model": "opencode-go/ox-alpha-free",
      "permission": {
        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
        },
      },
    },
    "review": {
      "description": "Reviews diffs for constraint violations and best practices; read-only",
      "model": "opencode-go/hy3",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
      },
    },
    "general": { "model": "opencode-go/ox-alpha-free" },
    "explore": { "model": "opencode-go/ox-alpha-free" },
    "compaction": { "model": "opencode-go/ox-alpha-free" },
    "title": { "model": "opencode-go/ox-alpha-free" },
    "summary": { "model": "opencode-go/ox-alpha-free" },
  },
}
