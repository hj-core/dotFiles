{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "plan",
  "share": "disabled",
  "formatter": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "coverage/**", ".next/**"]
  },
  "permissions": [
    { "action": "external_directory", "resource": "~/go/pkg/mod/*", "effect": "allow" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/**", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "go *", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm exec prettier *", "effect": "allow" },

    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "echo *$*", "effect": "deny" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "find *-delete*", "effect": "deny" },
    { "action": "shell", "resource": "find *-exec*", "effect": "deny" },

    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "cat *.env", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env.*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env.example", "effect": "allow" },
    { "action": "shell", "resource": "cat *.pem", "effect": "deny" },
    { "action": "shell", "resource": "cat *.key", "effect": "deny" },
    { "action": "shell", "resource": "cat */.ssh/*", "effect": "deny" },

    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "grep *.env", "effect": "deny" },
    { "action": "shell", "resource": "grep *.env.*", "effect": "deny" },
    { "action": "shell", "resource": "grep *.env.example", "effect": "allow" },
    { "action": "shell", "resource": "grep *.pem", "effect": "deny" },
    { "action": "shell", "resource": "grep *.key", "effect": "deny" },
    { "action": "shell", "resource": "grep */.ssh/*", "effect": "deny" },

    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rg *.env", "effect": "deny" },
    { "action": "shell", "resource": "rg *.env.*", "effect": "deny" },
    { "action": "shell", "resource": "rg *.env.example", "effect": "allow" },
    { "action": "shell", "resource": "rg *.pem", "effect": "deny" },
    { "action": "shell", "resource": "rg *.key", "effect": "deny" },
    { "action": "shell", "resource": "rg */.ssh/*", "effect": "deny" },

    { "action": "shell", "resource": "head *", "effect": "ask" },
    { "action": "shell", "resource": "tail *", "effect": "ask" },
    { "action": "shell", "resource": "sort *", "effect": "ask" },
    { "action": "shell", "resource": "uniq *", "effect": "ask" },
    { "action": "shell", "resource": "sed *", "effect": "ask" },
    { "action": "shell", "resource": "awk *", "effect": "ask" },

    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git stash *", "effect": "allow" },
    { "action": "shell", "resource": "git stash clear*", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },

    { "action": "shell", "resource": "rm *", "effect": "ask" }
  ],
  "agents": {
    "plan": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "~/.opencode/plan/**", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "review": {
      "description": "Reviews changes for correctness, regressions, and missing tests",
      "model": "opencode-go/glm-5.3-flash",
      "mode": "subagent",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }]
    },
    "general": { "model": "opencode-go/deepseek-v4.1-flash" },
    "explore": { "model": "opencode-go/deepseek-v4.1-flash" },
    "compaction": { "model": "opencode-go/deepseek-v4.1-flash" },
    "title": { "model": "opencode-go/deepseek-v4.1-flash" },
    "summary": { "model": "opencode-go/deepseek-v4.1-flash" }
  }
}
