{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "share": "disabled",
  "autoupdate": "notify",
  "model": "opencode-go/deepseek-v4-flash",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "coverage/**", ".next/**"],
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200,
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000,
    },
    "buffer": 20000,
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/go/pkg/mod/*",
      "effect": "allow",
    },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "cd ~/taresync/*", "effect": "allow" },
    { "action": "shell", "resource": "go *", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "pnpm exec prettier *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git stash *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "sed *-i*", "effect": "ask" },
    { "action": "shell", "resource": "sed *--in-place*", "effect": "ask" },
    { "action": "shell", "resource": "awk *-i*", "effect": "ask" },
    { "action": "shell", "resource": "awk *@load*", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
  ],
  "default_agent": "plan",
  "agents": {
    "plan": {
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
      ],
    },
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*.env.example", "effect": "allow" },
      ],
    },
    "review": {
      "model": "opencode-go/hy3",
      "mode": "subagent",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }],
    },
    "general": { "model": "opencode-go/deepseek-v4-flash" },
    "explore": { "model": "opencode-go/deepseek-v4-flash" },
    "compaction": { "model": "opencode-go/deepseek-v4-flash" },
    "title": { "model": "opencode-go/deepseek-v4-flash" },
    "summary": { "model": "opencode-go/deepseek-v4-flash" },
  },
}
